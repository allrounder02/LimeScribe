OPENAI_API_KEY=your_api_key_here
OPENAI_STT_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_STT_FALLBACK_URL=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=english
OPENAI_STT_RESPONSE_FORMAT=json
OPENAI_TTS_URL=https://api.openai.com/v1/audio/speech
OPENAI_TTS_FALLBACK_URL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_LANGUAGE=en-us
OPENAI_TTS_RESPONSE_FORMAT=wav
OPENAI_TTS_SPEED=1.0
OPENAI_TTS_INSTRUCTIONS=
OPENAI_CHAT_URL=https://api.openai.com/v1/chat/completions
OPENAI_CHAT_FALLBACK_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_SYSTEM_PROMPT=You are a helpful assistant.
VAD_PAUSE_THRESHOLD=1.5
VAD_AGGRESSIVENESS=3
VAD_MIN_SPEECH_SECONDS=0.5
LOG_LEVEL=INFO
LOG_FILE=
